# Built binaries
/bin/
# The built binary at the repository root. Unanchored, this also matched the
# source directory cmd/shisa-de and silently untracked the whole command line.
/shisa-de
*.exe
*.test
*.out

# A local tokenizer download: 32 MB, never checked in
/tmp/
tokenizer.json

# Python bytecode from running the recorder or its offline tests
__pycache__/
*.pyc

# The live parity recording. It is a measurement of the endpoint on one day, not
# an oracle: the served checkpoint is deterministic within a session and not
# across sessions, so the live test records its own and reads nothing from here.
# A manual `python3 scripts/live_parity.py` writes it for inspection.
testdata/live_python.json
testdata/live_python.meta.json
